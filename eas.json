{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "adhoc": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildType": "app-store"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "testFlightEnabled": true
      }
    }
  }
}